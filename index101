      <div class="menu-sub">L'Échiquier des Colonies</div>
    </div>
    <div class="menu-header-right">
      <div class="menu-score-inline" id="menu-score-bar">
        <div style="display:flex;flex-direction:column;align-items:center;gap:1px;">
          <span class="score-w" id="score-w-label">▲ 0</span>
          <span style="font-size:0.75rem;color:rgba(48,208,96,.7);letter-spacing:.05em;">victoires</span>
        </div>
        <span class="score-sep">·</span>
        <div style="display:flex;flex-direction:column;align-items:center;gap:1px;">
          <span class="score-l" id="score-l-label">▼ 0</span>
          <span style="font-size:0.75rem;color:rgba(255,48,80,.7);letter-spacing:.05em;">défaites</span>
        </div>
