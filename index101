      </div>
      <button class="menu-sound" id="snd-btn" onclick="openSoundModal()">🔊</button>
    </div>
  </div>

  <!--
    BARRE DE STATUT FREEMIUM
    Affiche en permanence : parties restantes, partages effectués, badge de statut.
