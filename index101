    </div>
    <div class="modal-body" style="gap:14px;">
      <p style="font-size:.95rem;line-height:1.65;color:rgba(224,220,255,.8);">
        IN-SECT est fait par <strong style="color:#C0A0FF;">une seule personne</strong>.<br>
        Ton retour compte vraiment pour la suite du jeu.
      </p>
      <div style="display:flex;flex-direction:column;gap:6px;">
        <label style="font-size:.8rem;color:rgba(255,255,255,.45);letter-spacing:.08em;">TA PIÈCE FAVORITE</label>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <button class="feedback-piece-btn" onclick="selectFeedbackPiece(this,'Reine Guêpe')">👑 Reine</button>
          <button class="feedback-piece-btn" onclick="selectFeedbackPiece(this,'Araignée')">🕷️ Araignée</button>
          <button class="feedback-piece-btn" onclick="selectFeedbackPiece(this,'Mouche')">🪰 Mouche</button>
          <button class="feedback-piece-btn" onclick="selectFeedbackPiece(this,'Scarabée')">🪲 Scarabée</button>
          <button class="feedback-piece-btn" onclick="selectFeedbackPiece(this,'Coccinelle')">🐞 Coccinelle</button>
          <button class="feedback-piece-btn" onclick="selectFeedbackPiece(this,'Fourmi')">🐜 Fourmi</button>
        </div>
      </div>
      <div style="display:flex;flex-direction:column;gap:6px;">
        <label style="font-size:.8rem;color:rgba(255,255,255,.45);letter-spacing:.08em;">TON MESSAGE (optionnel)</label>
